generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum UserRole {
  ADMIN
  MEMBER
}

enum WorkItemStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum WorkItemPriority {
  LOW
  MEDIUM
  HIGH
}

model User {
  id                String     @id @default(cuid())
  name              String
  email             String     @unique
  passwordHash      String
  role              UserRole
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  assignedWorkItems WorkItem[] @relation("WorkItemAssignee")
  createdWorkItems  WorkItem[] @relation("WorkItemCreator")
}

model WorkItem {
  id          String           @id @default(cuid())
  title       String
  description String           @default("")
  status      WorkItemStatus   @default(TODO)
  priority    WorkItemPriority @default(MEDIUM)
  assigneeId  String
  createdById String
  dueDate     DateTime
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  assignee    User             @relation("WorkItemAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  createdBy   User             @relation("WorkItemCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([assigneeId, dueDate])
  @@index([createdAt])
}
